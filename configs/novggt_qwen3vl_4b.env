# novggt_qwen3vl_4b: novggt on Qwen3-VL-4B-Instruct (memory / speed measurement for the 4B; same recipe otherwise).
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-4B-Instruct --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
