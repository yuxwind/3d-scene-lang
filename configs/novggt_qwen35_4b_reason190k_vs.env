# novggt_qwen35_4b_reason190k_vs: novggt_reason190k_vs's data on Qwen3.5-4B (novggt_qwen35_4b's model setup):
# --arch none, LoRA r64/a128 on the LLM incl. the DeltaNet projections, lr 1e-4, 1 fps <=64 frames, plain
# prompt, thinking off, trained on reason-190k as video + scene -> bare answer
# (data/reason190k_videoscene/build.py), 1 epoch at global batch 256 (569 steps).
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=reason190k_vs
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3.5-4B --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8
  --checkpoint_above 8192)
# A few rows run to 10-16k tokens (long scene lists / CoT) and OOM at step 132 without gradient checkpointing
# (75 GiB at the failing layer); checkpoint only micro-batches over 8,192 tokens, the rest run ~17% faster.
GRAD_CKPT=True
EVAL_ARGS=(--max_new_tokens 16)
