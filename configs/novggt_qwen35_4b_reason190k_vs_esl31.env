# novggt_qwen35_4b_reason190k_vs_esl31: novggt_qwen35_4b_reason190k_vs with a partial GT scene: each row's scene keeps
# only the objects of the detector's 31 classes (ESL31) and their synonyms (data/reason190k_videoscene_esl31/build.py,
# docs/vsibench_esl31_label_mapping.txt): the upper bound of a 31-class detector as the scene source. Otherwise:
# --arch none, LoRA r64/a128 on the LLM incl. the DeltaNet projections, lr 1e-4, 1 fps <=64 frames, plain
# prompt, thinking off, video + scene -> bare answer, 1 epoch at global batch 256 (569 steps).
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=reason190k_vs_esl31
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3.5-4B --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8
  --checkpoint_above 4200)
# Gradient checkpointing only for micro-batches over 4,200 tokens (same gradients), sized for 40 GB cards (A100):
# without checkpointing a row peaks at about 10.5 GiB + 5.9 GiB per 1k tokens (measured on wukong, per-device batch 1),
# so about 35 GiB at 4,200 tokens; about 98% of the rows are shorter. Larger cards can pass a higher value after the
# experiment name (scripts/wukong/launch_q35vs_esl31_wukong.sh: 4500 on 46 GB).
GRAD_CKPT=True
EVAL_ARGS=(--max_new_tokens 16)
