# novggt_qwen35_4b_reason190k_think: novggt_qwen35_4b's model setup (Qwen3.5-4B, --arch none, LoRA r64/a128
# on the LLM incl. the DeltaNet projections, lr 1e-4 from the base model, 1 fps <=64 frames) trained on
# reason-190k (the 145,647 SimpleSR traces) as video -> scene + CoT + answer: the trace's opener, <scene>
# list and reasoning inside Qwen3.5's own <think> block, then "Answer: X" (data/reason190k_think/build.py).
# Thinking on at train and eval (--prompt reason_plain). Same rows and steps as novggt_qwen35_4b_reason190k_vs
# (scene in the input instead): 1 epoch at global batch 256, 569 steps. Rows over 16,384 tokens are dropped.
# Eval generates up to 8,192 tokens and scores the text after the last "Answer:".
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=reason190k_think
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3.5-4B --arch none --prompt reason_plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8
  --checkpoint_above 8192
  --max_seq_len 16384)
# A few rows run to 10-16k tokens (long scene lists / CoT) and OOM at step 132 without gradient checkpointing
# (75 GiB at the failing layer); checkpoint only micro-batches over 8,192 tokens, the rest run ~17% faster.
GRAD_CKPT=True
EVAL_ARGS=(--max_new_tokens 8192)
EVAL_PARTS=4   # split a timed-out shard's leftover rows over 4 more jobs
