# novggt_qwen35_4b_reason190k_vs_think: novggt_qwen35_4b_reason190k_vs with a CoT target. Qwen3.5-4B, --arch none,
# LoRA r64/a128 on the LLM incl. the DeltaNet projections, lr 1e-4, 1 fps <=64 frames, trained on reason-190k
# (the 145,647 SimpleSR traces) as video + GT scene -> CoT + answer: the input is novggt_qwen35_4b_reason190k_vs's
# (the question objects' boxes in the user turn), the target is the trace's reasoning inside Qwen3.5's own <think>
# block, then "Answer: X" (data/reason190k_videoscene_think/build.py). Thinking on at train and eval
# (--prompt reason_scene). 1 epoch at global batch 256, 569 steps. Rows: median 4.1k tokens, 19% over 4.5k,
# longest 15,509 (none dropped). Eval generates up to 8,192 tokens and scores the text after the last "Answer:".
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=reason190k_vs_think
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3.5-4B --arch none --prompt reason_scene)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8
  --checkpoint_tiers 4200:all,7500:16,13500:8)
# Partial gradient checkpointing by row length (same gradients), sized for 40 GB cards (A100): rows up to 4,200
# tokens run without checkpointing, up to 7,500 with 16 of the 32 LLM layers checkpointed, up to 13,500 with 24,
# longer ones with all 32. Measured on wukong at per-device batch 1 (peak GiB at 4k / 8k / 15.5k tokens):
# none checkpointed 33 / OOM / OOM, 16 checkpointed 23 / 36 / OOM, 24 checkpointed 17 / 24 / 39, all 11 / 13 / 17;
# a 4k-token row takes 1.5 s without checkpointing and 1.8 s with all layers checkpointed.
# Larger cards can pass wider tiers after the experiment name (scripts/wukong/launch_q35vs_think_wukong.sh).
GRAD_CKPT=True
EVAL_ARGS=(--max_new_tokens 8192)
EVAL_PARTS=4   # split a timed-out shard's leftover rows over 4 more jobs
