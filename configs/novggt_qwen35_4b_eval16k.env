# novggt_qwen35_4b (video only), eval-only variant: up to 16,384 new tokens instead of 16. With the <|im_end|> stop
# token (sr_vggt/eval.py) the model still stops after its answer; the cap just rules out truncation. Rerun of
# checkpoint-743 on 2026-10-28 -> sr_vggt_novggt_qwen35_4b/eval_checkpoint-743_full_stopfix.
source "${SR_ROOT}/configs/novggt_qwen35_4b.env"
EVAL_ARGS=(--max_new_tokens 16384)
