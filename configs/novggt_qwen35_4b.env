# novggt_qwen35_4b: novggt's recipe on Qwen3.5-4B (hybrid LLM: 24 Gated-DeltaNet + 8 full-attention
# layers, no DeepStack), no VGGT branch. LoRA r64/a128 on the LLM: attention, MLP and the DeltaNet
# in_proj_qkv / in_proj_z / out_proj (train.py). Thinking off at train and eval (empty <think></think>
# in the prompt). Needs flash-linear-attention (setup_env.sh). Zero-shot: 0.5510 (docs/reproduce_exps.md).
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3.5-4B --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
