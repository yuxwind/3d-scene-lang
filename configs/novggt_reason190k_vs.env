# novggt_reason190k_vs: novggt's recipe (plain Qwen3-VL-2B, --arch none, LoRA r64/a128 on the LLM, lr 1e-4,
# 1 fps <=64 frames, plain prompt, 1 epoch at global batch 256), trained on reason-190k (the 145,647 SimpleSR
# traces) as video + scene -> answer: the trace's <scene> list (shuffled) goes into the human turn after the
# video line, and the target is the bare 190k answer (data/reason190k_videoscene/build.py). 569 steps.
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=reason190k_vs
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
