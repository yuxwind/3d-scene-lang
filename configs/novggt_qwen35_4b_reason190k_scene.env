# novggt_qwen35_4b_reason190k_scene: novggt_qwen35_4b_reason190k_vs without the video. Qwen3.5-4B, --arch none,
# LoRA r64/a128 on the LLM incl. the DeltaNet projections, lr 1e-4, plain prompt, thinking off, trained on
# reason-190k as GT scene text -> bare answer (data/reason190k_scene/build.py: the same 145,647 rows, scene
# blocks and targets, no video, scene-only system prompt data._SCENE_SYSTEM), 1 epoch at global batch 256
# (569 steps). Rows are a few hundred tokens, so no gradient checkpointing.
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=reason190k_scene
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3.5-4B --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
