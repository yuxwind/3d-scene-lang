# novggt: main's recipe on plain Qwen3-VL-2B, no VGGT branch (--arch none): LoRA r64/a128 on the
# LLM only, same 190k mix, frames (1 fps, <=64) and 743 steps at global batch 256. Prompt "plain"
# (main's short system prompt, no placeholders), as in spatialstack / vlm3r. The no-geometry
# baseline for every VGGT experiment. Zero-shot Qwen3-VL-2B: 0.5088 (docs/reproduce_exps.md).
VGGT_ARGS=(--video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch none --prompt plain)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
